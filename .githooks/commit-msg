#!/bin/sh
set -eu
# Git passes a path relative to the worktree; Git runs commit hooks from its root.
if command -v python3 >/dev/null 2>&1; then
    python=python3
elif command -v python >/dev/null 2>&1; then
    python=python
elif command -v py >/dev/null 2>&1; then
    python=py
else
    echo "Python 3.10+ is required for repository guards." >&2
    exit 1
fi
"$python" scripts/check_commit_messages.py --message-file "$1"
